{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/api-docs",
      "destination": "/api/index.js"
    },
    {
      "source": "/api-docs/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.js"
    }
  ]
}
